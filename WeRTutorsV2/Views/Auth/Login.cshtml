@model WeRTutorsV2.Models.LoginModel

@if (TempData["PopupMessage"] != null)
{
    <script>
        alert('@TempData["PopupMessage"]');
    </script>
}

<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="~/css/style_homepage.css" />

</head>



<body>


<header>
    <a href="https://wertutors.co.za" class="logo" style="text-align: center">WeRTutors</a>
    <img src="~/images/WRT-Website-Logo (1).jpg" alt="WeRTutors Logo" />
</header>


<nav>
    <ul>
        <li><a href="#login">Home</a></li>
        <li><a href="#admin">Admin</a></li>
        <li><a href="#tutor">Tutor</a></li>
        <li><a href="#client">Client</a></li>
    </ul>
</nav>


    <div class="container">
        <section id="login" class="login-form">
            <h2>Login</h2>
            <form method="post">
                <div>
                    <label>Email</label>
                    <input type="email" name="Email" required />
                </div>
                <div>
                    <label>Password</label>
                    <input type="password" name="Password" required />
                </div>
                <button type="submit">Login</button>
                <p class="signup-link">Don't have an account? @Html.ActionLink("Signup", "Signup", "Auth")</p>
            </form>
        </section>
    </div>
</body>

<p>@ViewBag.Message</p>
