@model WeRTutorsV2.Models.LoginModel


<img src="~/images/WRT-Website-Logo (1).jpg" alt="WeRTutors Logo" />
<link rel="stylesheet" href="~/css/AuthStyle.css" />
<h2>Login</h2>

<form method="post">
    <div>
        <label>Email</label>
        <input type="email" name="Email" required />
    </div>
    <div>
        <label>Password</label>
        <input type="password" name="Password" required />
    </div>
    <button type="submit">Login</button>
    <p1>Don't have an account? @Html.ActionLink("Signup", "Signup", "Auth")</p1>
</form>

<p>@ViewBag.Message</p>
