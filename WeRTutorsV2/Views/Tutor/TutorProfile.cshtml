@model WeRTutorsV2.Models.TutorSignupModel
<link rel="stylesheet" href="~/css/tutorProfile.css" />
<div class="container mt-4">
    <h2>Tutor Profile</h2>

    <div>
        <strong>Name:</strong> @Model.Name @Model.Surname
    </div>
    <div>
        <strong>Email:</strong> @Model.Email
    </div>
    <div>
        <strong>Phone Number:</strong> @Model.PhoneNumber
    </div>
    <div>
        <strong>Subjects:</strong> @String.Join(", ", Model.Subjects)
    </div>
    <div>
        <strong>Tutoring Experience:</strong> @String.Join(", ", Model.TutoringExperience)
    </div>
    <div>
        <strong>Preferred Teaching Level:</strong> @String.Join(", ", Model.PreferredTeachingLevel)
    </div>
    <div>
        <strong>Languages:</strong> @String.Join(", ", Model.Languages)
    </div>
    <div>
        <strong>Location:</strong> @Model.Location
    </div>
</div>